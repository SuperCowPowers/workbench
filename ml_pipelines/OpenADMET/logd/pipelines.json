{
  "pipelines": {
    "logd": [
      {
        "script": "logd.py",
        "inputs": [
          "fs:open_admet_logd"
        ],
        "outputs": [
          "model:logd-reg-xgb",
          "endpoint:logd-reg-xgb",
          "model:logd-reg-pytorch",
          "endpoint:logd-reg-pytorch",
          "model:logd-reg-chemprop",
          "endpoint:logd-reg-chemprop",
          "model:logd-reg-chemprop-desc",
          "endpoint:logd-reg-chemprop-desc"
        ]
      },
      {
        "script": "workbench:models/model_promotion.py",
        "inputs": [
          "model:logd-reg-xgb",
          "model:logd-reg-pytorch",
          "model:logd-reg-chemprop",
          "model:logd-reg-chemprop-desc"
        ],
        "outputs": [
          "endpoint:logd-reg-v1"
        ]
      }
    ],
    "logd_hpo": [
      {
        "script": "logd_chemprop_hpo.py",
        "inputs": [
          "fs:open_admet_logd"
        ],
        "outputs": [
          "model:logd-reg-chemprop-hpo",
          "endpoint:logd-reg-chemprop-hpo"
        ]
      }
    ]
  }
}

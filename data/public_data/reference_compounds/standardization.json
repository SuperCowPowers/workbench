{
  "csv_key": "comp_chem/reference_compounds/standardization.csv",
  "columns": [
    "id",
    "name",
    "input_smiles",
    "expected_smiles",
    "expected_salt",
    "expected_undefined_chiral_centers",
    "notes"
  ],
  "compounds": [
    {
      "name": "sodium_acetate",
      "input_smiles": "[Na+].CC(=O)[O-]",
      "expected_smiles": "CC(=O)O",

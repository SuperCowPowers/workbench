      "expected_undefined_chiral_centers": 0,
      "notes": "Canonical ionic salt — Na+ stripped, acetate neutralized to acetic acid"
    },
    {
      "name": "isoproterenol_hcl",
      "input_smiles": "CC(C)NCC(O)c1ccc(O)c(O)c1.Cl",
